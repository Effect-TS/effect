{
  "name": "@effect/auth-electron",
  "version": "4.0.5",
  "type": "module",
  "license": "MIT",
  "description": "Main-process Electron browser login and encrypted credential custody for Effect Auth.",
  "homepage": "https://effect.website",
  "repository": {
    "type": "git",
    "url": "https://github.com/Effect-TS/effect.git",
    "directory": "packages/auth-electron"
  },
  "bugs": {
    "url": "https://github.com/Effect-TS/effect/issues"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./BrowserLogin": "./src/BrowserLogin.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./BrowserLogin": "./dist/BrowserLogin.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/auth": "workspace:^"
  },
  "devDependencies": {
    "effect": "workspace:^",
    "electron": "44.5.1"
  },
  "peerDependencies": {
    "effect": "workspace:^",
    "electron": "^44.5.1"
  }
}
