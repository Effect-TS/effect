{
  "name": "@effect/protobuf-generator",
  "type": "module",
  "version": "4.0.6",
  "license": "MIT",
  "description": "protoc-gen-effect: generate Effect Schema modules from .proto files",
  "homepage": "https://effect.website",
  "repository": {
    "type": "git",
    "url": "https://github.com/Effect-TS/effect.git",
    "directory": "packages/tools/protobuf-generator"
  },
  "bugs": {
    "url": "https://github.com/Effect-TS/effect/issues"
  },
  "tags": [
    "typescript",
    "protobuf",
    "codegen"
  ],
  "keywords": [
    "typescript",
    "protobuf",
    "protoc",
    "buf",
    "codegen"
  ],
  "bin": {
    "protoc-gen-effect": "./src/bin.ts"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./bin": null,
    "./main": null,
    "./internal/*": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "bin": {
      "protoc-gen-effect": "./dist/bin.js"
    },
    "exports": {
      "./package.json": "./package.json",
      "./*": "./dist/*.js",
      "./bin": null,
      "./main": null,
      "./internal/*": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json",
    "bootstrap": "node bootstrap/generate.ts"
  },
  "peerDependencies": {
    "@effect/platform-node": "workspace:^",
    "effect": "workspace:^"
  },
  "devDependencies": {
    "effect": "workspace:^"
  }
}
